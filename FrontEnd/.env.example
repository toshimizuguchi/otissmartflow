# GEMINI_API_KEY: Required for Gemini AI Studio Copilot calls (opcional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o front-end está hospedado
APP_URL="MY_APP_URL"

# VITE_API_URL: URL do Backend Spring Boot (smartflow-api)
# Local: http://localhost:8080/api/v1 (ou /api/v1 se usar o proxy do Vite)
# Produção Deploy (Vercel/Railway/Render): https://sua-api.com/api/v1
VITE_API_URL="http://localhost:8080/api/v1"

# VITE_REPORTS_URL: URL do Motor de Relatórios Python FastAPI (smartflow-reports)
# Local: http://localhost:8000 (ou /reports se usar o proxy do Vite)
# Produção Deploy: https://seus-relatorios.com
VITE_REPORTS_URL="http://localhost:8000"
