{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd FrontEnd && npm install && npm run build",
  "outputDirectory": "FrontEnd/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://otissmartflow-1.onrender.com/api/v1/$1"
    },
    {
      "source": "/reports/(.*)",
      "destination": "https://otissmartflow-1.onrender.com/reports/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/FrontEnd/dist/index.html"
    }
  ]
}
